# ============================================================
# Variables d'environnement — DataBridge
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS COMMITER le fichier .env sur GitHub
# ============================================================

# --- Base de données PostgreSQL ---
# Sur Docker : POSTGRES_HOST=postgres (nom du service docker-compose)
# En local   : POSTGRES_HOST=localhost
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=databridge
POSTGRES_USER=databridge_user
POSTGRES_PASSWORD=changeme_mot_de_passe_fort

# --- Stockage fichiers MinIO ---
# Sur Docker : MINIO_ENDPOINT=minio (nom du service docker-compose)
# En local   : MINIO_ENDPOINT=localhost
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=changeme_login_minio
MINIO_SECRET_KEY=changeme_mot_de_passe_minio
MINIO_BUCKET=databridge-files

# --- Authentification JWT ---
# Utiliser une chaîne longue et aléatoire (minimum 32 caractères)
JWT_SECRET=changeme_utiliser_une_longue_chaine_aleatoire_ici
JWT_EXPIRATION=24h

# --- Backend ---
BACKEND_PORT=3000
NODE_ENV=development

# --- Frontend ---
# Sur Docker / VM : utiliser l'IP de la VM
# En local       : utiliser localhost
VITE_API_URL=http://localhost:3000
